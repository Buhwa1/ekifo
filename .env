# ── Database (Supabase) ──────────────────────────────────────────────
# Supabase dashboard → Connect (top bar) → "Connection string".
# App: Transaction pooler (port 6543) — best for Next.js / serverless.
DATABASE_URL=postgresql://postgres.rlareahmlczhxhpouqxx:M6nlH1LbTzMsuTVf@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres.rlareahmlczhxhpouqxx:M6nlH1LbTzMsuTVf@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
APP_SECRET=d+Aj+f/wEQeX+lLkvB8AMDcZjd4Wro2Dlv36pOIA6S99KifdMaEnuhG0h61tQH5d
# Optional: paste Supabase's CA cert (Database settings → SSL) to fully verify TLS. Use \n for newlines.
DATABASE_CA_CERT=""
DB_POOL_MAX=5
# Tests insert rows — point them at a SEPARATE throwaway project, never the real one.
TEST_DATABASE_URL=""

# Local Postgres instead? e.g. DATABASE_URL="postgresql://ekifo:ekifo@localhost:5432/findekifo"

# ── Core ─────────────────────────────────────────────────────────────
# 32+ random chars. Used to pepper NIN hashes and OTP hashes.
# APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated E.164 numbers that become ADMIN on first login.
ADMIN_PHONES="+256700000001"

# ── Business rules (UGX) ────────────────────────────────────────────
COMMISSION_BPS=400                 # 4% booking commission (300–500 per spec)
WRITTEN_AGREEMENT_THRESHOLD=500000 # rent at/above this gets an auto-generated agreement
RENT_INCREASE_CAP_BPS=1000         # 10% per 12 months on active tenancies
HOLD_PAYMENT_WINDOW_MIN=15         # time to approve the Mobile Money PIN
HOLD_DURATION_HOURS=72             # how long a paid hold reserves a unit before admin review

# ── SMS / WhatsApp OTP ──────────────────────────────────────────────
# "console" prints messages to the server log (dev). "termii" sends real SMS.
SMS_PROVIDER="console"
TERMII_API_KEY=""
TERMII_SENDER_ID="FindEkifo"

# ── Payments ────────────────────────────────────────────────────────
# "mock" auto-succeeds after a few seconds (dev). "flutterwave" charges real Mobile Money.
PAYMENT_PROVIDER="mock"
FLW_SECRET_KEY=""
FLW_WEBHOOK_HASH=""   # the "secret hash" set in the Flutterwave dashboard

# ── Media ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Cron ────────────────────────────────────────────────────────────
# Bearer token for /api/cron/* (call every minute from Vercel Cron, GitHub Actions or crontab).
CRON_SECRET="change-me"

# Staging/demo only: run with mock payments + console SMS in a production build.
# ALLOW_MOCK_PROVIDERS=1
